TELEGRAM_TOKEN=your_telegram_bot_token_here
ADMIN_ID=your_telegram_user_id_here
DEBUG_MODE=false

# --- Single account (legacy) ---
# HETZNER_API_TOKEN=your_hetzner_api_token_here

# --- Multiple accounts ---
# Format: name1:token1,name2:token2,...
# Each name is shown in the bot's "Switch Account" menu.
HETZNER_ACCOUNTS=personal:token_aaa111,work:token_bbb222,staging:token_ccc333

# --- PasarGuard node setup (optional) ---
# "Create as node" in the create wizard and "Add to Panel" on a server appear
# only when NODE_SETUP_URL and at least one panel are set.
# Raw URL of setup.sh (include the GitHub token if the repo is private).
# NODE_SETUP_URL=https://TOKEN@raw.githubusercontent.com/OWNER/REPO/main/setup.sh
# Panel names: lowercase letters/digits/'-' ('-' is '_' in the keys); each needs URL, USERNAME, PASSWORD
# (a sudo admin of that panel). CORE_ID is optional (default: first core config).
# PANELS=main
# PANEL_MAIN_URL=https://panel.example.com
# PANEL_MAIN_USERNAME=admin
# PANEL_MAIN_PASSWORD=secret
# PANEL_MAIN_CORE_ID=1

# --- Mini App (optional) ---
# Set up by `hetzner webapp <subdomain>`: certificate (certbot), a random port,
# these keys and a restart. The subdomain needs an A record to this server
# ("DNS only" on Cloudflare), and TCP 80 + the port open in any firewall.
# WEBAPP_DOMAIN=panel.example.com
# WEBAPP_PORT=34567
# Certificate files (default: /etc/letsencrypt/live/<domain>/fullchain.pem, privkey.pem)
# WEBAPP_CERT=
# WEBAPP_KEY=
